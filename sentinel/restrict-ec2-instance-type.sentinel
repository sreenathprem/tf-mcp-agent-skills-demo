# Restrict EC2 instance types to the approved, cost-controlled list.
# Owner: Cloud Platform Team · Enforcement: hard-mandatory (all AWS workspaces)

import "tfplan/v2" as tfplan

param allowed_types default [
	"t3.micro",
	"t3.small",
	"t3.medium",
	"t3.large",
	"m6i.large",
]

# All EC2 instances that are being created or updated
ec2_instances = filter tfplan.resource_changes as _, rc {
	rc.type is "aws_instance" and
		rc.mode is "managed" and
		(rc.change.actions contains "create" or rc.change.actions contains "update")
}

violations = filter ec2_instances as address, rc {
	rc.change.after.instance_type not in allowed_types
}

for violations as address, rc {
	print(address, "uses instance type", rc.change.after.instance_type,
		"- allowed types are:", allowed_types)
}

main = rule {
	length(violations) is 0
}
